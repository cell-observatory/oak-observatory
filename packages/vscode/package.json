    "colors": [
      {
        "id": "claudeObservatory.pendingBadge",
        "description": "Badge colour for files with agent edits still awaiting review (Explorer and editor tabs).",
        "defaults": {
          "dark": "#E5C07B",
          "light": "#B8860B",
          "highContrast": "#E5C07B",
          "highContrastLight": "#B8860B"
        }
      }
    ],
    "configurationDefaults": {
      "diffEditor.hideUnchangedRegions.enabled": true
    },
    "configuration": {
      "title": "OAK",
      "properties": {
        "claudeObservatory.inlineReview": {
          "type": "boolean",
          "default": true,
          "description": "Show the agent's pending edits inline in the editor: gutter change-bars on changed lines, red ghost text for removed lines, and a per-edit lens carrying Keep, Undo, Chat, Diff and Details."
        },
        "claudeObservatory.revealNextOnResolve": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "After you keep or revert a single edit, open the next edit still awaiting review \u2014 in another file when that is where it is. Bulk operations, redo, and the diff editor's own buttons never move the cursor; the floating review bar always follows, and the review bubble follows only while pinned."
        },
        "claudeObservatory.editorReviewSurface": {
          "type": "string",
          "enum": [
            "floating",
            "bubble",
            "none"
          ],
          "default": "floating",
          "scope": "window",
          "enumDescriptions": [
            "The compact floating review bar over the code: Keep \u00b7 Undo \u00b7 \u2303\u2304 \u00b7 \u2039\u203a \u00b7 Diff \u00b7 Details, with a live 'Agent edit #12 \u00b7 +8 \u22123 \u00b7 Diff 2/5 \u00b7 File 1/3' title (the default; same as PyCharm's floating bar).",
            "The full review bubble instead: the agent's reasoning and the diff in git's colours, with the same buttons. Taller \u2014 it covers about 15\u201325 lines of code.",
            "Neither. The inline lens and the status-bar nav bar still work, and the 'Show the review bar at this edit' command still opens the bar on demand."
          ],
          "description": "Which review controls appear in the editor, over the file, while it has edits awaiting review. Auto-shows and follows as you keep, undo and step; never steals focus. 'Collapse' and 'Details' swap between the two surfaces at any time."
        },
        "claudeObservatory.pinnedPeek": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Keep the review BUBBLE open after Keep or Undo and carry it to the next edit awaiting review, crossing into another file when this one is done. The floating review bar always follows \u2014 it is a navigation bar \u2014 so this setting governs the bubble only."
        },
        "claudeObservatory.inlineDiffView": {
          "type": "boolean",
          "default": true,
          "description": "Open an agent edit's before \u27f7 after diff in the unified (inline) view \u2014 the red/green single-column look \u2014 instead of side-by-side. Best-effort: flips a freshly opened diff via VS Code's built-in inline toggle when your editor defaults to side-by-side."
        },
        "claudeObservatory.claudeBin": {
          "type": "string",
          "default": "",
          "description": "Path to the `claude` CLI used for opt-in 'Analyze'/'Generate suggestions' (leave empty to auto-detect on PATH / common locations)."
        },
        "claudeObservatory.session": {
          "type": "string",
          "default": "",
          "description": "Pin which capture session the observatory shows (a session id, e.g. `demo-showcase`). Leave empty to auto-resolve the newest session for the workspace. Use the 'Switch session' button to change it."
        },
        "claudeObservatory.overviewLocation": {
          "type": "string",
          "enum": [
            "panel",
            "editor"
          ],
          "default": "panel",
          "enumDescriptions": [
            "Bottom panel, beside Stats (the default).",
            "An editor tab, opened beside your code. The bottom-panel Overview goes quiet while the tab is open \u2014 only one of them refreshes."
          ],
          "description": "Where the Overview opens. 'editor' opens it as a tab on startup; you can also use the 'Open Overview in Editor' command at any time."
        },
        "claudeObservatory.openAllPreviewLines": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "description": "In \"Open all in editor\", show at most this many changed lines per diff \u2014 the rest stays one click away on the row's Open full diff. 0 shows every diff in full."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --loader:.wasm=binary --outfile=dist/extension.js",
    "build": "npm run typecheck && npm run bundle",
    "package": "vsce package --no-dependencies -o oak-observatory.vsix",
    "vscode:prepublish": "node -e \"require('node:fs').copyFileSync('../../THIRD_PARTY_NOTICES.md', 'THIRD_PARTY_NOTICES.md')\""
  },
