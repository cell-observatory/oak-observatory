<idea-plugin>
  <id>com.cell-observatory.oak-observatory</id>
  <name>OAK</name>
  <vendor url="https://github.com/cell-observatory/oak-observatory">Cell Observatory</vendor>
  <description><![CDATA[
    Per-edit <b>Keep / Undo</b> for Claude Code and Codex, with a log of captured file changes.
    Capture runs in local hooks, outside the model loop, without git or extra model tokens.<br/><br/>
    Requires the <code>oak</code> CLI on this machine (the plugin drives it for all
    store mutations) and the capture hooks installed via <code>oak init</code>.
    Works in every JetBrains IDE; on Remote Development the plugin installs on the host.
  ]]></description>

  <!-- Platform-only: loads in PyCharm CE/Pro, IntelliJ, WebStorm, … no Python APIs used. -->
  <depends>com.intellij.modules.platform</depends>
  <extensions defaultExtensionNs="com.intellij">
    <!-- Stripe icons need explicit 13x13 size + palette hex colors (the IDE recolors known hex
         values per theme; `currentColor` is not supported by the platform SVG icon loader). -->
    <toolWindow id="Observatory Traces" anchor="left" icon="/icons/toolWindowObservatory.svg"
                factoryClass="com.cellobservatory.observatory.ui.ObservatoryToolWindowFactory"/>
    <toolWindow id="Observatory Dashboards" anchor="bottom" icon="/icons/toolWindowObservatory.svg"
                factoryClass="com.cellobservatory.observatory.ui.ObservatoryDashboardsFactory"/>
    <toolWindow id="Observatory Timeline" anchor="right" icon="/icons/toolWindowObservatory.svg"
                factoryClass="com.cellobservatory.observatory.ui.ObservatoryTimelineFactory"/>
    <!-- The guided tour's window. Declared (not registered at runtime, which invokes an override-only
         platform API) and unavailable until a tour runs — see TourToolWindowFactory. -->
    <toolWindow id="OAK Tour" anchor="right" canCloseContents="false"
                icon="/icons/toolWindowObservatory.svg"
                factoryClass="com.cellobservatory.observatory.ui.tour.TourToolWindowFactory"/>
    <!-- The "Open all in editor" tab: our own stacked review editor over a ReviewAllVirtualFile
         (public diff APIs — the platform's combined diff is internal surface with no per-block
         action seam). -->
    <fileEditorProvider implementation="com.cellobservatory.observatory.ui.ReviewAllEditorProvider"/>
    <statusBarWidgetFactory id="claudeObservatoryStatus" order="first"
                            implementation="com.cellobservatory.observatory.ui.ObservatoryStatusBarWidgetFactory"/>
    <statusBarWidgetFactory id="claudeObservatoryActions" order="after claudeObservatoryStatus"
                            implementation="com.cellobservatory.observatory.ui.ObservatoryActionsWidgetFactory"/>
    <statusBarWidgetFactory id="claudeObservatoryUsage" order="after claudeObservatoryActions"
                            implementation="com.cellobservatory.observatory.ui.ObservatoryUsageWidgetFactory"/>
    <editorNotificationProvider implementation="com.cellobservatory.observatory.ui.editor.ObservatoryEditorBanner"/>
    <!-- The floating review bar over the code. `implementation` only, with no group id: the EP consumes
         the ActionGroup INSTANCE the provider returns, so a registered <group> would be dead weight.
         Which of this and the banner appear is the `editorReviewSurface` setting (default: this one). -->
    <editorFloatingToolbarProvider
        implementation="com.cellobservatory.observatory.ui.editor.ObservatoryFloatingToolbarProvider"/>
    <applicationConfigurable parentId="tools" id="com.cell-observatory.oak-observatory.settings"
                             displayName="OAK"
                             instance="com.cellobservatory.observatory.settings.ObservatoryConfigurable"/>
    <notificationGroup id="OAK" displayType="BALLOON"/>
    <projectViewNodeDecorator implementation="com.cellobservatory.observatory.ui.ObservatoryNodeDecorator"/>
    <postStartupActivity implementation="com.cellobservatory.observatory.services.ObservatoryStartup"/>
  </extensions>

  <actions>
    <group id="ClaudeObservatory.Group" text="OAK" popup="false">
      <action id="ClaudeObservatory.ReviewNext"
              class="com.cellobservatory.observatory.actions.ReviewNextAction"
              text="OAK: Review Next Pending Edit"
              description="Jump to the oldest pending agent edit">
        <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt N"/>
        <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt N" replace-all="true"/>
      </action>
      <action id="ClaudeObservatory.ReviewPrev"
              class="com.cellobservatory.observatory.actions.ReviewPrevAction"
              text="OAK: Review Previous Pending Edit"
              description="Step to the previous pending agent edit">
        <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt P"/>
        <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt P" replace-all="true"/>
      </action>
      <action id="ClaudeObservatory.AddReviewComment"
              class="com.cellobservatory.observatory.actions.AddReviewCommentAction"
              text="OAK: Add Review Comment"
              description="Comment for the agent on the pending edit under the cursor">
        <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt C"/>
        <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt C" replace-all="true"/>
      </action>
      <action id="ClaudeObservatory.SendReviewComments"
              class="com.cellobservatory.observatory.actions.SendReviewCommentsAction"
              text="OAK: Send Review Comments to Agent"
              description="Batch unsent review comments into an editable dialog draft; Send submits it through herdr"/>
      <action id="ClaudeObservatory.QuoteLastReply"
              class="com.cellobservatory.observatory.actions.QuoteLastReplyAction"
              text="OAK: Quote Agent's Last Reply into Prompt"
              description="Quote the agent's last reply into an editable dialog draft as a &gt; block; Send submits it through herdr"/>
      <action id="ClaudeObservatory.NextAttention"
              class="com.cellobservatory.observatory.actions.NextAttentionAction"
              text="OAK: Jump to the Next Session Waiting on You"
              description="Permission prompts first, then questions, then input waits — the needs-you inbox's order">
        <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt I"/>
        <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt I" replace-all="true"/>
      </action>
      <action id="ClaudeObservatory.SearchConversations"
              class="com.cellobservatory.observatory.actions.SearchConversationsAction"
              text="OAK: Search Conversations…"
              description="Find the asks you typed and the answers you got, across every session on this machine"/>
      <action id="ClaudeObservatory.KeepAtCursor"
              class="com.cellobservatory.observatory.actions.KeepAtCursorAction"
              text="OAK: Keep Pending Edit at Cursor"
              description="Keep the pending agent edit under the cursor">
        <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt Y"/>
        <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt Y" replace-all="true"/>
      </action>
      <action id="ClaudeObservatory.UndoAtCursor"
              class="com.cellobservatory.observatory.actions.UndoAtCursorAction"
              text="OAK: Undo Pending Edit at Cursor"
              description="Surgically undo the pending agent edit under the cursor">
        <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt U"/>
        <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt U" replace-all="true"/>
      </action>
      <action id="ClaudeObservatory.KeepOpenFile"
              class="com.cellobservatory.observatory.actions.KeepOpenFileAction"
              text="OAK: Accept All Edits in File"
              description="Accept every pending agent edit in the active file">
        <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt K"/>
        <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt K" replace-all="true"/>
      </action>
      <action id="ClaudeObservatory.UndoOpenFile"
              class="com.cellobservatory.observatory.actions.UndoOpenFileAction"
              text="OAK: Reject All Edits in File"
              description="Revert every pending agent edit in the active file">
        <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt R"/>
        <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt R" replace-all="true"/>
      </action>
      <action id="ClaudeObservatory.DiffPrevRevision"
              class="com.cellobservatory.observatory.actions.DiffPrevRevisionAction"
              text="OAK: Diff Previous Revision"
              description="Diff the current file against the state produced by the previous agent edit">
        <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt OPEN_BRACKET"/>
        <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt OPEN_BRACKET" replace-all="true"/>
      </action>
      <action id="ClaudeObservatory.DiffNextRevision"
              class="com.cellobservatory.observatory.actions.DiffNextRevisionAction"
              text="OAK: Diff Next Revision"
              description="Diff the current file against the state produced by the next agent edit">
        <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt CLOSE_BRACKET"/>
        <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt CLOSE_BRACKET" replace-all="true"/>
      </action>
      <!-- Session-level utilities: reachable from Find Action / keybindable (no default keymaps). Each
           reuses the shared panel handler (ReviewOps / the service), so behavior never forks. -->
      <action id="ClaudeObservatory.SetupCheck"
              class="com.cellobservatory.observatory.actions.SetupCheckAction"
              text="OAK: Setup Check (doctor)"
              description="Open the setup diagnostics — hooks, PATH, config, session, status line"/>
      <action id="ClaudeObservatory.ExportSummary"
              class="com.cellobservatory.observatory.actions.ExportReviewSummaryAction"
              text="OAK: Export Review Summary"
              description="Export a shareable markdown review summary (kept/reverted per file)"/>
      <action id="ClaudeObservatory.SwitchSession"
              class="com.cellobservatory.observatory.actions.SwitchSessionAction"
              text="OAK: Switch Session"
              description="Pick which capture session the observatory shows"/>
      <action id="ClaudeObservatory.CleanStore"
              class="com.cellobservatory.observatory.actions.CleanStoreAction"
              text="OAK: Clean Store…"
              description="Garbage-collect orphaned blobs, or drop the whole session"/>
      <action id="ClaudeObservatory.InstallHooks"
              class="com.cellobservatory.observatory.actions.InstallHooksAction"
              text="OAK: Install Capture Hooks"
              description="Install the PreToolUse/PostToolUse capture hooks (oak init)"/>
      <action id="ClaudeObservatory.AcceptAll"
              class="com.cellobservatory.observatory.actions.AcceptAllEditsAction"
              text="OAK: Accept All Edits"
              description="Accept every pending agent edit in this session"/>
      <action id="ClaudeObservatory.RevertAll"
              class="com.cellobservatory.observatory.actions.RevertAllEditsAction"
              text="OAK: Reject All Edits"
              description="Revert every pending agent edit in this session"/>
      <action id="ClaudeObservatory.RedoAll"
              class="com.cellobservatory.observatory.actions.RedoAllEditsAction"
              text="OAK: Redo All Edits"
              description="Re-apply every undone agent edit in this session"/>
      <action id="ClaudeObservatory.ClearResolved"
              class="com.cellobservatory.observatory.actions.ClearResolvedEditsAction"
              text="OAK: Clear Resolved Edits"
              description="Clear the resolved (kept/undone) edits from the log; pending edits are kept"/>
      <action id="ClaudeObservatory.Spotlight"
              class="com.cellobservatory.observatory.actions.SpotlightAction"
              icon="AllIcons.Actions.IntentionBulb"
              text="OAK: Toggle Spotlight"
              description="Dim the unedited lines to foreground Claude's changes"/>
      <action id="ClaudeObservatory.SearchEdits"
              class="com.cellobservatory.observatory.actions.SearchEditsAction"
              text="OAK: Search Edits"
              description="Filter the Review list and the Overview ledger by file path"/>
      <!-- Demo mode (0.8.9). Cancel is the replay's own progress-bar Cancel; Restart is the reset, and
           it is the same operation as Start because a run clears any previous demo before replaying. -->
      <action id="ClaudeObservatory.StartDemo"
              class="com.cellobservatory.observatory.actions.StartDemoAction"
              icon="AllIcons.Actions.Execute"
              text="OAK: Start Demo Mode"
              description="Replay a scripted Claude session through the real pipeline, then take the guided tour"/>
      <action id="ClaudeObservatory.RestartDemo"
              class="com.cellobservatory.observatory.actions.RestartDemoAction"
              icon="AllIcons.Actions.Restart"
              text="OAK: Restart Demo"
              description="Replay the demo from the beginning, replacing the current one"/>
      <action id="ClaudeObservatory.StartTour"
              class="com.cellobservatory.observatory.actions.StartTourAction"
              text="OAK: Guided Tour"
              description="Walk every panel of the observatory, step by step"/>
      <action id="ClaudeObservatory.TourNext"
              class="com.cellobservatory.observatory.actions.TourNextAction"
              text="OAK: Guided Tour — Next Step"
              description="Advance the guided tour"/>
      <action id="ClaudeObservatory.TourBack"
              class="com.cellobservatory.observatory.actions.TourBackAction"
              text="OAK: Guided Tour — Previous Step"
              description="Step the guided tour back"/>
      <action id="ClaudeObservatory.TourPlayPause"
              class="com.cellobservatory.observatory.actions.TourPlayPauseAction"
              text="OAK: Guided Tour — Pause or Resume"
              description="Pause or resume the guided tour's autoplay"/>
      <action id="ClaudeObservatory.ExitDemo"
              class="com.cellobservatory.observatory.actions.ExitDemoAction"
              icon="AllIcons.Actions.Cancel"
              text="OAK: Exit Demo Mode"
              description="Leave demo mode and remove every trace: both sessions, the demo folder, and the report written outside the workspace"/>
    </group>
  </actions>
</idea-plugin>
