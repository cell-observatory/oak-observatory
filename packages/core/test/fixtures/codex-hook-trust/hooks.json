{
  "description": "claude-observatory capture hooks (managed entries only — your own entries are preserved)",
  "hooks": {
    "Interrupt": [
      {
        "hooks": [
          {
            "command": "oak capture --agent codex #oak-observatory-hook",
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "oak capture --agent codex #oak-observatory-hook",
            "type": "command"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "oak capture --agent codex #oak-observatory-hook",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "oak capture --agent codex #oak-observatory-hook",
            "type": "command"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "oak capture --agent codex #oak-observatory-hook",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "oak capture --agent codex #oak-observatory-hook",
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "oak capture --agent codex #oak-observatory-hook",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "oak capture --agent codex #oak-observatory-hook",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash '/home/user/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "oak capture --agent codex #oak-observatory-hook",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "oak capture --agent codex #oak-observatory-hook",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "oak capture --agent codex #oak-observatory-hook",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "oak capture --agent codex #oak-observatory-hook",
            "type": "command"
          }
        ]
      }
    ]
  }
}