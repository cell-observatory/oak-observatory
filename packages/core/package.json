{
  "name": "@oak-observatory/core",
  "version": "0.11.0-dev.0",
  "private": true,
  "description": "Capture + git-free snapshot store + surgical undo engine for OAK. No model calls.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run gen:herdr-lock && tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/herdr-api.d.ts', 'dist/herdr-api.d.ts')\"",
    "gen:herdr-lock": "node scripts/gen-herdr-lock.js",
    "gen:herdr": "node scripts/gen-herdr-types.js",
    "test:herdr": "node --test test/herdr.test.js"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "smol-toml": "1.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cell-observatory/oak-observatory.git"
  },
  "homepage": "https://github.com/cell-observatory/oak-observatory#readme",
  "bugs": {
    "url": "https://github.com/cell-observatory/oak-observatory/issues"
  }
}
